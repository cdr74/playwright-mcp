# Copy to .env and fill in. Never commit .env.
#
# No ANTHROPIC_API_KEY needed - the harness drives Claude Code (`claude -p`)
# rather than the Anthropic API directly, billed against an existing Claude
# Code subscription instead of metered API usage. You do need the `claude`
# CLI installed and authenticated (`claude auth login`) - see CLAUDE.md
# decision 3 and harness/README.md.
CLAUDE_MODEL=sonnet

# Optional overrides (defaults shown):
# PRIMER=v3                        # app-knowledge primer version, docs/app-knowledge/ (CLAUDE.md decision 14)
# CLAUDE_RUN_TIMEOUT_MS=1800000    # per-phase `claude -p` timeout, 30 min

# Target app under test - self-hosted via app/docker-compose.yml, see app/README.md
TARGET_APP_URL=http://localhost:8081/
OHRM_PORT=8081
OHRM_DB_ROOT_PASSWORD=orangehrm_root
OHRM_DB_NAME=orangehrm
OHRM_DB_USER=orangehrm
OHRM_DB_PASSWORD=orangehrm

# Created by app/install.sh via the checked-in app/cli_install_config.yaml
# Quoted deliberately: dotenv treats an unquoted `#` as starting a comment
# and silently truncates the value (harness/src/seed.ts hit this for real).
OHRM_ADMIN_USER=Admin
OHRM_ADMIN_PASSWORD="PwMcpBench#2026"
